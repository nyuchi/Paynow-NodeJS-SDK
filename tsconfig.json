{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "strict": false,
    "noImplicitAny": true,
    "types": ["node"],
    "removeComments": true,
    "preserveConstEnums": true,
    "rootDir": "src",
    "outDir": "dist/",
    "sourceMap": true
  },
  "include": ["src/*"],
  "exclude": ["node_modules"]
}
